# ===========================================
# c-learnloop skill — Environment Variables
# ===========================================
# Copy to .env and fill in real values.

# ----- LearnLoop API (skill-specific) -----
LEARNLOOP_ENV="dev"                              # "dev" | "prod"
LEARNLOOP_API_URL_DEV="http://localhost:3021"
LEARNLOOP_API_URL_PROD="https://api.learnloop.cc"
LEARNLOOP_API_KEY_DEV="ll_test_..."
LEARNLOOP_API_KEY_PROD="ll_live_..."
LEARNLOOP_COMMUNITY_SLUG="your-community-slug"   # x-community-slug header value

# ----- Database (Railway Postgres) -----
DATABASE_URL="postgresql://user:password@host:5432/learnloop"

# ----- Redis (Railway or Upstash) -----
REDIS_URL="redis://default:password@host:6379"

# ----- Clerk Authentication -----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ----- Stripe Payments -----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PLATFORM_FEE_PERCENT=10

# ----- Cloudflare R2 Storage -----
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-key"
CLOUDFLARE_R2_BUCKET_NAME="learnloop-assets"
CLOUDFLARE_R2_PUBLIC_URL="https://media.learnloop.cc"

# ----- Cloudflare Stream (video hosting) -----
CLOUDFLARE_STREAM_API_TOKEN="your-stream-api-token"
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN="customer-xxx"

# ----- AI Providers -----
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
FAL_API_KEY="fal_..."

# ----- Email (Resend) -----
RESEND_API_KEY="re_..."
EMAIL_FROM="Learn Loop <hello@learnloop.com>"

# ----- Push Notifications (OneSignal) -----
ONESIGNAL_APP_ID="your-app-id"
ONESIGNAL_API_KEY="your-api-key"

# ----- Application URLs -----
NEXT_PUBLIC_APP_URL="http://localhost:3020"
NEXT_PUBLIC_API_URL="http://localhost:3021"

# ----- Environment -----
NODE_ENV="development"
