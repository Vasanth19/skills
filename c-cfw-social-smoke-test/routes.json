    { "path": "/api/v1/captures/{captureId}/events", "methods": ["GET", "POST"], "auth": "public" },
    { "path": "/api/v1/captures/{captureId}/link", "methods": ["POST"], "auth": "public", "body": { "workspaceId": "$WORKSPACE_ID" } },
    { "path": "/api/v1/captures/{captureId}/status", "methods": ["GET"], "auth": "signed-token" },

    { "path": "/api/v1/channels/telegram/connect", "methods": ["POST"], "auth": "webhook", "body": {} },
