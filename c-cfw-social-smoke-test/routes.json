{
  "_comment": "Manifest of every src/app/api/**/route.ts handler in cfw-social. The `auth` tag is the GATEWAY-level auth (what src/proxy.ts allows), NOT just what the handler imports. Many handlers call requireApiBrand but the middleware blocks unauthenticated traffic upstream, so the effective auth is `session`. Placeholders inside {...} must match a key in PLACEHOLDER inside smoke.mjs. Regenerate by hand; bump _version.",
  "_version": "2026-05-18.1",
  "routes": [
    { "path": "/api/health", "methods": ["GET"], "auth": "public" },

    { "path": "/api/v1/agents", "methods": ["POST"], "auth": "session", "body": { "workspaceId": "$WORKSPACE_ID", "archetype": "free-form" } },
    { "path": "/api/v1/agents/{agentId}/discovery", "methods": ["PUT"], "auth": "session", "body": { "allowDiscovery": true } },
    { "path": "/api/v1/agents/{agentId}/skills", "methods": ["POST", "DELETE"], "auth": "session", "body": { "skillName": "c-broll" } },

    { "path": "/api/v1/api-keys", "methods": ["GET", "POST"], "auth": "session", "body": { "name": "smoke-test" } },
    { "path": "/api/v1/api-keys/{apiKeyId}", "methods": ["DELETE"], "auth": "session" },

    { "path": "/api/v1/approval/{token}/chat", "methods": ["GET", "POST"], "auth": "signed-token" },
    { "path": "/api/v1/approval/{token}/runs", "methods": ["POST"], "auth": "signed-token" },

    { "path": "/api/v1/audit-log", "methods": ["POST"], "auth": "api-or-session", "body": {} },

    { "path": "/api/v1/billing/checkout", "methods": ["POST"], "auth": "session", "body": { "plan": "creator", "brandId": "$BRAND_ID" } },
