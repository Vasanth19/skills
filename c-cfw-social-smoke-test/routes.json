    { "path": "/api/v1/dev/media/{mediaPath}", "methods": ["GET"], "auth": "public" },
    { "path": "/api/v1/dev/telegram-bot", "methods": ["POST"], "auth": "public", "body": {} },
    { "path": "/api/v1/dev/telegram-rewire", "methods": ["POST"], "auth": "webhook", "body": {} },
    { "path": "/api/v1/dev/upload", "methods": ["PUT"], "auth": "public" },
