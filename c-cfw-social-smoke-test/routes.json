    { "path": "/api/v1/brands/{brandId}/insights", "methods": ["GET"], "auth": "api-or-session" },
    { "path": "/api/v1/brands/{brandId}/insights/{insightId}", "methods": ["PATCH", "DELETE"], "auth": "api-or-session", "body": { "alwaysOn": true } },
    { "path": "/api/v1/brands/channel-connections", "methods": ["GET", "POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/brands/channel-connections/{channelConnectionId}", "methods": ["DELETE"], "auth": "session" },
    { "path": "/api/v1/brands/mine", "methods": ["GET"], "auth": "session" },

    { "path": "/api/v1/captures", "methods": ["POST"], "auth": "signed-token" },
