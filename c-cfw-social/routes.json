{
  "_comment": "Manifest of every src/app/api/**/route.ts handler in cfw-social. The `auth` tag is the GATEWAY-level auth (what src/proxy.ts allows), NOT just what the handler imports. Many handlers call requireApiBrand but the middleware blocks unauthenticated traffic upstream, so the effective auth is `session`. This is the DOCUMENTATION manifest (realistic example bodies). A sibling copy lives in the c-cfw-social-smoke-test skill with smoke-safe bodies — keep auth tags in sync when either changes. Regenerate by hand; bump _version.",
  "_version": "2026-06-02.1",
  "routes": [
    { "path": "/api/health", "methods": ["GET"], "auth": "public" },

    { "_comment": "Better Auth catch-all — sign-in, sign-up, session, sign-out, etc. Auth is delegated to Better Auth's own handlers.", "path": "/api/auth/{...all}", "methods": ["GET", "POST"], "auth": "public" },

    { "_comment": "Hono catch-all — mirrors v1 routes through src/lib/api/routes/* under /api/v2. Each Hono sub-route has its own auth; see src/lib/api/routes/ for canonical bodies. Currently a parallel surface to v1 during the V2 migration.", "path": "/api/v2/{...path}", "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"], "auth": "api-or-session" },

    { "path": "/api/v1/agents", "methods": ["POST"], "auth": "api-or-session", "_note": "PR #49 (2026-06-02): requireApiBrand — external brand-key agents can create their own roster. Proxy ALWAYS_OPEN_EXACT entry (EXACT, not prefix, so rig-up stays session-gated). Body: { name?, skillNames[], persona?, allowDiscovery?, workspaceId? } → 201 { agentId }.", "body": { "name": "VSL Writer", "skillNames": ["p-vsl"], "persona": "You write punchy VSL scripts.", "allowDiscovery": false } },
    { "path": "/api/v1/agents/rig-up", "methods": ["POST"], "auth": "session", "_note": "Standard-crew rig-up — intentionally session-only (PR #49 left this gated).", "body": { "workspaceId": "$WORKSPACE_ID" } },
    { "path": "/api/v1/agents/{agentId}", "methods": ["PATCH", "DELETE"], "auth": "session", "body": { "name": "updated" } },
    { "path": "/api/v1/agents/{agentId}/discovery", "methods": ["PUT"], "auth": "api-or-session", "_note": "AB-KEYMINT: proxy ALWAYS_OPEN_REGEXES + requireApiBrand.", "body": { "allowDiscovery": true } },
    { "path": "/api/v1/agents/{agentId}/skills", "methods": ["POST", "DELETE"], "auth": "api-or-session", "_note": "AB-KEYMINT: proxy ALWAYS_OPEN_REGEXES + requireApiBrand.", "body": { "skillName": "c-broll" } },

    { "path": "/api/v1/api-keys", "methods": ["GET", "POST"], "auth": "api-or-session", "_note": "AB-KEYMINT: mint/list brand keys via master key (cfw-api-key + x-cfw-brand) or an existing brand key.", "body": { "name": "my-agent" } },
    { "path": "/api/v1/api-keys/{apiKeyId}", "methods": ["DELETE"], "auth": "api-or-session" },

    { "path": "/api/v1/approval/{token}/chat", "methods": ["GET", "POST"], "auth": "signed-token" },
    { "path": "/api/v1/approval/{token}/runs", "methods": ["POST"], "auth": "signed-token" },

    { "path": "/api/v1/audit-log", "methods": ["POST"], "auth": "api-or-session", "body": {} },

    { "path": "/api/v1/billing/checkout", "methods": ["POST"], "auth": "session", "_note": "Intentionally session-only — a leaked brand key must not change the plan.", "body": { "plan": "creator", "brandId": "$BRAND_ID" } },
    { "path": "/api/v1/billing/portal", "methods": ["POST"], "auth": "session", "_note": "Intentionally session-only.", "body": { "brandId": "$BRAND_ID" } },

    { "path": "/api/v1/brand-secrets", "methods": ["GET", "PUT"], "auth": "api-or-session", "_note": "PR #49 (2026-06-02): provider-key vault. requireApiBrand + authorizeVault (brand-key/master-key pass; session requires role=owner → 403 owner_only). GET returns masked hints only ({ secrets: [{ provider, envVar, known, maskedHint, createdAt, lastUsedAt }] }); PUT upserts { provider, value } (AES-256-GCM at rest). Known providers: heygen, elevenlabs, kie, perplexity, replicate, gemini, fal; custom kebab-case names allowed except deny-listed infra prefixes.", "body": { "provider": "heygen", "value": "hg_xxxxxxxxxxxxxxxx" } },
    { "path": "/api/v1/brand-secrets/{provider}", "methods": ["DELETE"], "auth": "api-or-session", "_note": "PR #49: delete one provider key. Same authorizeVault gate." },

    { "path": "/api/v1/brand/{brandId}/captures", "methods": ["GET"], "auth": "signed-token" },
    { "path": "/api/v1/brand/{brandId}/context", "methods": ["GET"], "auth": "api-or-session" },
    { "path": "/api/v1/brand/dna", "methods": ["GET"], "auth": "api-or-session" },
    { "path": "/api/v1/brand/setup", "methods": ["POST"], "auth": "session", "body": {} },

    { "path": "/api/v1/brands/{brandId}/insights", "methods": ["GET", "POST"], "auth": "api-or-session", "body": { "kind": "tone", "value": "playful" } },
    { "path": "/api/v1/brands/{brandId}/insights/{insightId}", "methods": ["PATCH", "DELETE"], "auth": "api-or-session", "body": { "alwaysOn": true } },
    { "path": "/api/v1/brands/{brandId}/memory-settings", "methods": ["GET", "PATCH"], "auth": "api-or-session", "body": { "memoryEnabled": true } },
    { "path": "/api/v1/brands/channel-connections", "methods": ["GET", "POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/brands/channel-connections/{channelConnectionId}", "methods": ["DELETE"], "auth": "session" },
    { "path": "/api/v1/brands/director", "methods": ["PATCH"], "auth": "session", "body": { "agentId": "any" } },
    { "path": "/api/v1/brands/mine", "methods": ["GET"], "auth": "session" },

    { "path": "/api/v1/captures", "methods": ["POST"], "auth": "signed-token" },
    { "path": "/api/v1/captures/pending", "methods": ["GET"], "auth": "public" },
    { "path": "/api/v1/captures/presign-upload", "methods": ["GET"], "auth": "signed-token" },
    { "path": "/api/v1/captures/{captureId}/events", "methods": ["GET", "POST"], "auth": "public" },
    { "path": "/api/v1/captures/{captureId}/link", "methods": ["POST"], "auth": "public", "body": { "workspaceId": "$WORKSPACE_ID" } },
    { "path": "/api/v1/captures/{captureId}/status", "methods": ["GET"], "auth": "signed-token" },

    { "path": "/api/v1/channels/telegram/auto-connect", "methods": ["POST"], "auth": "api-or-session", "_note": "PR #53 (05-TGDEEPLINK, 2026-06-02): Auto-mode connect. Claims a TelegramBotPool bot for the brand, sets webhook, mints owner verify token. Returns { botUsername, deepLink, qrCodeDataUrl, expiresAt }. 409 pool_exhausted when pool empty. If brand already has a bot, skips claiming and just mints a token.", "body": {} },
    { "path": "/api/v1/channels/telegram/connect", "methods": ["POST"], "auth": "api-or-session", "_note": "Manual mode (PR #54 opened it for headless provisioning). Body: { botToken, allowedUserIds?[] }.", "body": {} },
    { "path": "/api/v1/channels/telegram/verify-tokens", "methods": ["POST"], "auth": "api-or-session", "_note": "PR #53: mint a deep-link verify token (role owner|member) for the brand's existing bot. Tap t.me/<bot>?start=<token> → webhook auto-captures the user ID into the allowlist. Single-use, 15-min expiry.", "body": { "role": "member" } },
    { "path": "/api/v1/channels/telegram/{telegramChannelId}", "methods": ["DELETE"], "auth": "session" },

    { "path": "/api/v1/character-refs", "methods": ["GET"], "auth": "session" },

    { "path": "/api/v1/chat/web", "methods": ["POST"], "auth": "session", "body": { "message": "smoke ping", "brandId": "$BRAND_ID" } },
    { "path": "/api/v1/chat/web/{conversationId}", "methods": ["GET"], "auth": "session" },

    { "path": "/api/v1/compositions/{compositionId}", "methods": ["DELETE"], "auth": "api-or-session", "_note": "Soft-deletes dish + revokes live approval tokens. Added to proxy ALWAYS_OPEN_REGEXES 2026-05-27." },
    { "path": "/api/v1/compositions/{compositionId}/send-for-approval", "methods": ["POST"], "auth": "session", "body": {} },

    { "path": "/api/v1/dev/brands", "methods": ["GET", "POST", "PATCH"], "auth": "public", "body": {} },
    { "path": "/api/v1/dev/media/{mediaPath}", "methods": ["GET"], "auth": "public" },
    { "path": "/api/v1/dev/r2-smoke", "methods": ["GET"], "auth": "api-or-session" },
    { "path": "/api/v1/dev/telegram-bot", "methods": ["POST"], "auth": "public", "body": {} },
    { "path": "/api/v1/dev/telegram-rewire", "methods": ["POST"], "auth": "webhook", "body": {} },
    { "path": "/api/v1/dev/upload", "methods": ["PUT"], "auth": "public" },
    { "path": "/api/v1/dev/upload-fail", "methods": ["PUT"], "auth": "public" },

    { "path": "/api/v1/discord/interactions", "methods": ["POST"], "auth": "webhook" },

    { "path": "/api/v1/image-templates", "methods": ["GET"], "auth": "session" },

    { "path": "/api/v1/inbox/approve", "methods": ["POST"], "auth": "signed-token" },
    { "path": "/api/v1/inbox/conversation", "methods": ["GET"], "auth": "api-or-session" },
    { "path": "/api/v1/inbox/regenerate", "methods": ["POST"], "auth": "signed-token" },
    { "path": "/api/v1/inbox/reject", "methods": ["POST"], "auth": "signed-token" },
    { "path": "/api/v1/inbox/revoke", "methods": ["POST"], "auth": "session", "body": {} },

    { "path": "/api/v1/mcp", "methods": ["POST"], "auth": "api-or-session", "headers": { "Accept": "application/json, text/event-stream" }, "body": { "jsonrpc": "2.0", "id": 1, "method": "initialize", "params": { "protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": { "name": "smoke", "version": "1" } } } },

    { "path": "/api/v1/me/delete-account", "methods": ["POST"], "auth": "session", "_note": "Intentionally session-only — account deletion requires a logged-in human.", "body": {} },

    { "path": "/api/v1/media/upload", "methods": ["POST"], "auth": "session", "body": {} },

    { "path": "/api/v1/music-tracks", "methods": ["GET"], "auth": "session" },

    { "path": "/api/v1/ops-prescriptions", "methods": ["GET"], "auth": "api-or-session" },
    { "path": "/api/v1/ops-prescriptions/admin", "methods": ["GET"], "auth": "webhook", "_note": "operator-only surface: uses Better-Auth session + User.role='admin', returns 404 (not 403) by design. Skipped by smoke runner — not reachable via master-key auth." },

    { "path": "/api/v1/posts/calendar", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/posts/count", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/posts/list", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/posts/quick", "methods": ["POST"], "auth": "api-or-session", "_note": "PR #49 (2026-06-02): requireApiBrand — external agents publish multi-platform in one call. Matched by the existing posts/{id} proxy regex. Connected platforms schedule via PFM; unconnected ones (or saveAsDraft: true) save as drafts. Response: { count, scheduled, drafted, failed, posts[] }.", "body": { "platforms": ["instagram", "linkedin"], "captionsByPlatform": { "instagram": "IG caption", "linkedin": "LI caption" }, "mediaUrls": ["https://r2.example/image.png"], "kind": "image", "saveAsDraft": false } },
    { "path": "/api/v1/posts/quick/generate-captions", "methods": ["POST"], "auth": "session", "body": { "compositionBody": "test" } },
    { "path": "/api/v1/posts/{postId}", "methods": ["PATCH", "DELETE"], "auth": "api-or-session", "body": { "status": "draft" } },

    { "path": "/api/v1/recipes/run", "methods": ["POST"], "auth": "session", "body": {} },

    { "path": "/api/v1/repurpose/ai", "methods": ["POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/repurpose/compose", "methods": ["POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/repurpose/save", "methods": ["POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/repurpose/saved", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/repurpose/search", "methods": ["POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/repurpose/stream", "methods": ["POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/repurpose/transcript", "methods": ["POST"], "auth": "session", "body": {} },

    { "path": "/api/v1/research/run", "methods": ["POST"], "auth": "session", "body": {} },

    { "path": "/api/v1/runs", "methods": ["POST"], "auth": "api-or-session", "_note": "AB-KEYMINT: proxy ALWAYS_OPEN_EXACT + requireApiBrand. Start a run headlessly.", "body": {} },
    { "path": "/api/v1/runs/{runId}/events", "methods": ["GET"], "auth": "api-or-session", "_note": "AB-KEYMINT: proxy ALWAYS_OPEN_REGEXES — replay-aware SSE polling." },

    { "path": "/api/v1/skills", "methods": ["GET", "POST"], "auth": "session", "body": {} },

    { "path": "/api/v1/slack/events", "methods": ["POST"], "auth": "webhook" },

    { "path": "/api/v1/social/accounts", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/social/accounts/import", "methods": ["POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/social/accounts/{socialAccountId}", "methods": ["DELETE"], "auth": "session" },
    { "path": "/api/v1/social/callback/postforme", "methods": ["GET"], "auth": "public" },
    { "path": "/api/v1/social/connect", "methods": ["POST"], "auth": "session", "body": { "platform": "linkedin" } },

    { "path": "/api/v1/team", "methods": ["GET"], "auth": "session" },

    { "path": "/api/v1/telegram/webhook/{botToken}", "methods": ["POST"], "auth": "webhook" },

    { "path": "/api/v1/webhooks/postforme/events", "methods": ["POST"], "auth": "webhook" },

    { "path": "/api/v1/workspaces/list", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/workspaces/{workspaceId}", "methods": ["PATCH", "DELETE"], "auth": "session", "body": { "name": "smoke-rename" } },
    { "path": "/api/v1/workspaces/{workspaceId}/assets", "methods": ["GET", "POST"], "auth": "session", "body": {} },
    { "path": "/api/v1/workspaces/{workspaceId}/compositions", "methods": ["GET", "POST"], "auth": "api-or-session", "_note": "GET: list compositions. POST: create ONE multi-platform dish (REST wrapper for propose_composition MCP logic). Body: { format, platforms[], captionIntent?, mediaUrls[]?, platformCaptions[{platform,caption}]? }. Returns { compositionId, platforms[], outputs[{outputId,platform,caption}] }. Added to proxy ALWAYS_OPEN_REGEXES 2026-05-27.", "body": { "format": "post", "platforms": ["instagram", "linkedin"], "captionIntent": "Caption text", "mediaUrls": ["https://r2.example/image.png"], "platformCaptions": [{ "platform": "instagram", "caption": "IG caption" }, { "platform": "linkedin", "caption": "LI caption" }] } },
    { "path": "/api/v1/workspaces/{workspaceId}/outputs", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/workspaces/{workspaceId}/posts", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/workspaces/{workspaceId}/runs", "methods": ["GET"], "auth": "session" },
    { "path": "/api/v1/workspaces/{workspaceId}/sources", "methods": ["GET", "POST", "DELETE"], "auth": "session", "body": { "kind": "url", "url": "https://example.com", "name": "smoke" } },

    { "path": "/api/webhooks/stripe", "methods": ["POST"], "auth": "webhook" }
  ]
}
